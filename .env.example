# Salin menjadi .env kalau lebih suka variabel lingkungan.
# Isi salah satu pasangan key di bawah; jangan di-commit.

TH_API_KEY=thk_...
TH_BASE_URL=https://tokenharbor.ai/v1
TH_MODEL=deepseek-v4.1-flash:free

# Alias yang juga dibaca aplikasi:
# TOKEN_HARBOR_API_KEY=
# TOKEN_HARBOR_BASE_URL=
# TOKEN_HARBOR_MODEL=

# Paksa mode contoh tanpa memanggil model.
# LA_DEMO=1

# Lokasi basis data (default .data/learning.db).
# LA_DB_PATH=.data/learning.db